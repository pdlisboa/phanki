{
  "name": "phanki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @phanki/server & npm run dev -w @phanki/web",
    "build": "npm run build -w @phanki/web && npm run build -w @phanki/server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p .",
    "test": "vitest run",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "testcontainers": "^12.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false,
    "fsevents": false,
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false
  }
}
